{
  "permissions": {
    "allow": [
      "Bash(npm install:*)",
      "Bash(npm run:*)",
      "Bash(npm test:*)",
      "Bash(npx expo:*)",
      "Bash(npx tsc:*)",
      "Bash(node scripts/sync-shared.mjs)",
      "Bash(bash scripts/test-db.sh)",
      "Bash(supabase start)",
      "Bash(supabase status)",
      "Bash(supabase db reset)",
      "Bash(supabase migration new:*)",
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push origin main)",
      "Bash(python3 scripts/check-migrations.py:*)",
      "Bash(git log:*)",
      "Bash(git fetch:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./apps/mobile/.env.local)",
      "Read(./supabase/.env)",
      "Bash(git push --force:*)",
      "Bash(supabase db push --linked:*)",
      "Bash(rm -rf:*)",
      "Bash(git push -f:*)",
      "Bash(git push * --force*)",
      "Bash(git push * +*)",
      "Bash(git push origin :*)",
      "Bash(git push * --delete*)"
    ]
  }
}
