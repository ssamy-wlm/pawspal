{
  "permissions": {
    "allow": [
      "Bash(git push origin main)",
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(npm run typecheck)",
      "Bash(npm run lint)",
      "Bash(npm test)",
      "Bash(bash scripts/test-db.sh)",
      "Bash(python3 scripts/check-migrations.py:*)"
    ],
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push * --force*)",
      "Bash(git push * -f)",
      "Bash(git push * +*)",
      "Bash(git push origin :*)",
      "Bash(git push * --delete*)",
      "Bash(git push * --mirror*)"
    ]
  }
}
