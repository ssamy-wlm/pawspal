# Settings for the Edge Functions. Copy to supabase/functions/.env for local work (that file is never committed).
# On the hosted project, set these as Edge Function secrets (Supabase dashboard, Edge Functions, Secrets).
# SUPABASE_URL, SUPABASE_ANON_KEY and SUPABASE_SERVICE_ROLE_KEY are provided by Supabase itself.

# --- Sign-in codes: who delivers them (see supabase/functions/README.md) ---
# Secret for the Send SMS hook (dashboard: Authentication, Hooks, Send SMS, "Generate secret").
SEND_SMS_HOOK_SECRET=
# Providers to try, in order: whatsapp-cloud, generic-http. Leave empty until you have chosen one.
SMS_PROVIDERS=
# Wording of the message ({{code}} is replaced). Default is bilingual.
# SMS_MESSAGE=PawsPal: your code is {{code}} | رمز PawsPal: {{code}}

# generic-http: any SMS company with an HTTPS API (including Egyptian providers)
# SMS_HTTP_URL=https://sms.example.com/api/send
# SMS_HTTP_HEADERS={"Authorization":"Bearer <key>"}
# SMS_HTTP_BODY={"to":"{{to}}","message":"{{message}}"}
# SMS_HTTP_FORMAT=json

# whatsapp-cloud: WhatsApp codes through Meta's Cloud API
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_TEMPLATE_NAME=
# WHATSAPP_TEMPLATE_LANG=ar

# --- Optional CAPTCHA after two wrong codes (turnstile or hcaptcha). Empty = wait 10 minutes instead. ---
# CAPTCHA_PROVIDER=
# CAPTCHA_SECRET=

# --- ID and selfie checks ---
# Empty = nobody can be verified. "fake" approves everyone (for building and testing only).
IDENTITY_PROVIDER=
# Set to production on the live project. Then "fake" also needs ALLOW_FAKE_IDENTITY=true.
# PAWSPAL_ENV=production
# ALLOW_FAKE_IDENTITY=true
