# Settings for the Edge Functions. Copy to supabase/functions/.env for local work (that file is never committed).
# On the hosted project, set these as Edge Function secrets (Supabase dashboard, Edge Functions, Secrets).
# SUPABASE_URL, SUPABASE_ANON_KEY and SUPABASE_SERVICE_ROLE_KEY are provided by Supabase itself.

# --- Timers: each scheduled function proves itself with a shared secret (24 characters or more) ---
CLEANUP_SECRET=
REMINDER_SECRET=

# --- Membership reminder emails ---
# Provider (default resend), its key, and the sender, for example "PawsPal <hello@your-domain>".
# EMAIL_PROVIDER=resend
RESEND_API_KEY=
EMAIL_FROM=
