{
  "$comment": "PawsPal Dahab design tokens. Single source of truth for the app AND the social media kit. Text colours were checked for WCAG AA contrast on their intended backgrounds.",
  "color": {
    "brand": {
      "teal": "#1FA3A3",
      "tealDeep": "#167E7E",
      "orange": "#FF9F43",
      "coral": "#FF6B6B",
      "sand": "#F6E7CB",
      "cream": "#FFF7EC",
      "navy": "#1F2D3D"
    },
    "tint": {
      "teal": "#D6EFEF",
      "orange": "#FFE5C8",
      "orangeSoft": "#FFB86E",
      "sand": "#EBD5AE",
      "coral": "#FFE1E1",
      "sea": "#BFE5E5"
    },
    "light": {
      "background": "#FFF7EC",
      "surface": "#FFFFFF",
      "surfaceTint": "#F6E7CB",
      "border": "#E9DCC3",
      "text": "#1F2D3D",
      "textMuted": "#4A5664",
      "primary": "#167E7E",
      "onPrimary": "#FFFFFF",
      "accent": "#FF9F43",
      "onAccent": "#1F2D3D",
      "danger": "#C93A3A",
      "onDanger": "#FFFFFF",
      "success": "#167E7E",
      "link": "#167E7E"
    },
    "dark": {
      "$comment": "The deep-navy theme from the 'Safe by design' posts. Used for dark mode and for trust/safety screens in light mode.",
      "background": "#1F2D3D",
      "surface": "#26394C",
      "surfaceRaised": "#2E4459",
      "border": "#3A5068",
      "text": "#FFF7EC",
      "textMuted": "#C3CCD5",
      "primary": "#3BC0C0",
      "onPrimary": "#1F2D3D",
      "accent": "#FF9F43",
      "onAccent": "#1F2D3D",
      "danger": "#FF8A8A",
      "onDanger": "#1F2D3D",
      "success": "#3BC0C0",
      "link": "#7FD8D8"
    },
    "pet": {
      "dogTan": "#E8B06A", "dogLight": "#F7D9A8", "dogEar": "#A8642E",
      "catOrange": "#FF9F43", "catMuzzle": "#FFE9D2", "catEye": "#7BC96F",
      "blackCat": "#3A4654", "huskyGrey": "#5E6B78", "huskyWhite": "#F2F4F6", "huskyEye": "#6EB6E8",
      "tongue": "#FF6B6B", "innerEar": "#FFC2C2"
    }
  },
  "font": {
    "family": "Poppins",
    "familyArabic": "Cairo",
    "weight": { "regular": 400, "medium": 500, "semibold": 600, "bold": 700, "extrabold": 800 },
    "size": { "caption": 12, "small": 14, "body": 16, "lead": 18, "title": 22, "headline": 28, "display": 36, "hero": 48 }
  },
  "radius": { "chip": 999, "button": 999, "card": 24, "sheet": 32, "input": 16, "phone": 44 },
  "space": { "xs": 4, "sm": 8, "md": 12, "lg": 16, "xl": 24, "xxl": 32, "xxxl": 48 },
  "shadow": { "card": { "color": "#1F2D3D", "opacity": 0.12, "radius": 30, "offsetY": 12 } },
  "motion": {
    "$comment": "Same timings as the social media animations. See docs/motion.md.",
    "duration": { "tap": 220, "fast": 250, "pop": 450, "enter": 600, "swipeOut": 500, "promote": 450, "stamp": 400, "pinDrop": 450, "heartBurst": 1250, "breathe": 3000 },
    "overshoot": { "soft": 1.4, "bubble": 1.6, "pop": 1.7, "bouncy": 1.9 },
    "stagger": { "toes": 120, "words": 80, "bubbles": 600, "cards": 120 }
  }
}
